# fosipcore environment configuration
#
# System-wide per-user config:  /etc/fosipcore/<username>.env
# Per-user overrides:           ~/.config/fosipcore/env
# (the per-user file is loaded later and takes precedence)

# Tracing filter (default: info,fosipcore=info)
RUST_LOG=info

# WebSocket port for the service manager (default: 50000)
#FOSIPCORE_SERVICE_MANAGER_PORT=50000

# Per-session HTTP-FLV port range (defaults: base 20000, count 6000)
#FOSIPCORE_LIVE_PORT_BASE=20000
#FOSIPCORE_LIVE_PORT_COUNT=6000
